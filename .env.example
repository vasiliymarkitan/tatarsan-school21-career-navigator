# Telegram Login Widget + digest (получить у @BotFather)
TELEGRAM_BOT_TOKEN=
BOT_USERNAME=

# JWT: минимум 32 символа. Не коммитьте реальный секрет.
# python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# httpOnly cookie: true только за HTTPS. На демо :8083 оставьте false.
COOKIE_SECURE=false

# LLM: yandex (демо) или gigachat (оставить переключаемым)
LLM_PROVIDER=yandex

# YandexGPT Lite / AI Studio
# https://aistudio.yandex.ru/ — API-ключ + folder id
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_MODEL=yandexgpt-lite
YANDEX_API_BASE=https://ai.api.cloud.yandex.net/v1

# Yandex Search API (текстовый веб-поиск = XML в rawData, не JSON-карточки).
# По умолчанию тот же YANDEX_API_KEY (Api-Key + folderId в теле). IAM Bearer — запасной.
# К каталогу нужен биллинг-аккаунт. Если 401/403 — роли search-api.webSearch.user
# и/или search-api.executor, scope yc.search-api.execute, либо отдельный ключ:
# YANDEX_SEARCH_API_KEY=
# Необязательно: другой хост Search API
# YANDEX_SEARCH_API_URL=https://searchapi.api.cloud.yandex.net

# GigaChat остаётся доступен, если LLM_PROVIDER=gigachat
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS

# Необязательно: свой User-Agent для hh.ru без личного email
# HH_USER_AGENT=CareerNavigator21/1.0 (+https://github.com/vasiliymarkitan/tatarsan-school21-career-navigator)

DIGEST_STORE_PATH=data/digest_settings.json
REFRESH_INTERVAL_SEC=1800
